# Copy to .env.local (local) or set in the hosting dashboard (production).

# Resend API key (https://resend.com/api-keys). Without it the contact form
# fails in production and only logs messages in development.
RESEND_API_KEY=

# Optional sender. Must be on a domain verified in Resend.
CONTACT_FROM="SBP Website <website@sbp-management.com>"
