// Cloudflare Workers config for the site (built with @opennextjs/cloudflare).
// Secrets such as RESEND_API_KEY are NOT set here: add them in the Cloudflare dashboard
// (Worker → Settings → Variables and Secrets) or with `npx wrangler secret put RESEND_API_KEY`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbp-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sbp-website"
    }
  ],
  // Resizes images for next/image (Cloudflare Images; the free allowance covers this site easily).
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CONTACT_FROM": "SBP Website <website@sbp-management.com>"
  },
  "observability": {
    "enabled": true
  }
}
